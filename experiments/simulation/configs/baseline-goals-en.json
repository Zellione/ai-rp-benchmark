{
  "backend": {
    "name": "llamacpp",
    "base_url": "http://127.0.0.1:8080",
    "model": "mistral-small-3.2-q8",
    "mode": "chat",
    "timeout": 300
  },
  "sampling": {
    "temperature": 0.8,
    "top_p": 0.95,
    "max_tokens": 8192
  },
  "player_sampling": {
    "temperature": 0.7,
    "top_p": 0.95,
    "max_tokens": 4096
  },
  "runtime": {
    "empty_response_retries": 1,
    "controlled_player": true,
    "player_knowledge_rules": [],
    "goal_criteria": {
      "schema_version": 1,
      "goals": {
        "subgoal-01": {
          "criteria": [
            {
              "id": "trust-cooperation",
              "description": "Mara demonstrates meaningful voluntary cooperation with Alex beyond basic politeness. A friendly tone alone does not satisfy this criterion.",
              "evidence_contains": "cooperation"
            }
          ]
        },
        "subgoal-02": {
          "criteria": [
            {
              "id": "disappearance-information",
              "description": "Alex obtains specific, credible information about the circumstances of the key's disappearance. Vague speculation is insufficient.",
              "evidence_contains": "key"
            }
          ]
        },
        "subgoal-03": {
          "criteria": [
            {
              "id": "archive-clue",
              "description": "Alex obtains a concrete investigable clue from Mara about an object, location or record in the archive. A general invitation to ask questions is insufficient.",
              "evidence_contains": "archive"
            }
          ]
        }
      }
    },
    "semantic_evaluator": {
      "mode": "llm",
      "id": "archivist-goal-smoke-en-v1",
      "sampling": {
        "temperature": 0,
        "top_p": 1,
        "max_tokens": 4096
      },
      "max_attempts": 2
    }
  }
}
